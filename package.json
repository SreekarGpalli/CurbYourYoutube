{
  "name": "curb-your-youtube",
  "version": "1.0.3",
  "private": true,
  "license": "MIT",
  "description": "YouTube distraction controls and session timers for Chrome and Firefox",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "node scripts/e2e-test.cjs",
    "test:e2e:live": "node scripts/live-e2e-test.cjs",
    "test:thumbnails": "node scripts/thumbnail-test.cjs",
    "test:thumbnails:live": "node scripts/thumbnail-test.cjs --live",
    "test:homepage": "node scripts/homepage-test.cjs",
    "test:navigation": "node scripts/navigation-test.cjs",
    "test:search": "node scripts/native-search-test.cjs",
    "test:search:live": "node scripts/native-search-test.cjs --live",
    "test:controls": "node scripts/controls-test.cjs",
    "test:all": "node scripts/test-all.cjs",
    "check": "node scripts/check.mjs",
    "package": "node scripts/package.mjs && node scripts/check.mjs && node scripts/check-package.mjs",
    "test:chrome-store": "node scripts/chrome-store-test.cjs",
    "test:layout": "node scripts/layout-test.cjs",
    "test:search-submit": "node scripts/search-submission-test.cjs",
    "test:search-textarea": "node scripts/textarea-search-test.cjs",
    "test:summary-button": "node scripts/summary-pill-test.cjs",
    "test:summary-card": "node scripts/summary-card-test.cjs",
    "test:summary-guards": "node scripts/summary-guards-test.cjs",
    "clean": "node scripts/clean.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
